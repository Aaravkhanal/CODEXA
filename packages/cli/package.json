{
  "name": "codexa",
  "version": "0.2.0",
  "description": "AI Software Engineering Agent — runs in your terminal, works in any project",
  "module": "src/index.tsx",
  "type": "module",
  "private": false,
  "license": "MIT",
  "homepage": "https://github.com/Aaravkhanal/CODEXA",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaravkhanal/CODEXA.git"
  },
  "bugs": {
    "url": "https://github.com/Aaravkhanal/CODEXA/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal",
    "anthropic",
    "openai",
    "ollama",
    "llm",
    "software-engineering"
  ],
  "bin": {
    "codexa": "./bin/codexa.cjs"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun --packages external",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "files": [
    "bin/",
    "scripts/postinstall.cjs",
    "src/",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@codexa/server": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.61",
    "@codexa/agent": "workspace:*",
    "@codexa/shared": "workspace:*",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "ai": "^7.0.58",
    "date-fns": "^4.4.0",
    "hono": "^4.12.28",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.7",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.6",
    "react-router": "^8.2.0",
    "zod": "^4.4.3"
  }
}
