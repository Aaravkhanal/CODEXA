{
  "name": "codexa",
  "version": "0.2.1",
  "description": "AI Software Engineering Agent — runs in your terminal, works in any project",
  "module": "src/index.tsx",
  "type": "module",
  "private": false,
  "license": "MIT",
  "homepage": "https://github.com/Aaravkhanal/CODEXA",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaravkhanal/CODEXA.git"
  },
  "bugs": {
    "url": "https://github.com/Aaravkhanal/CODEXA/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal",
    "anthropic",
    "openai",
    "ollama",
    "llm",
    "software-engineering"
  ],
  "bin": {
    "codexa": "./bin/codexa.cjs"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "files": [
    "bin/",
    "scripts/postinstall.cjs",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@codexa/server": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {}
}
