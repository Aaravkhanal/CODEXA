# -----------------------------------------------------------------------------
# CODEXA — Local Environment Variables Example
#
# Copy this file to '.env' at the repository root and configure the variables.
# Do NOT commit your actual '.env' file to version control.
# -----------------------------------------------------------------------------

# ---- CLI Configuration ------------------------------------------------------
# Override URL for the CLI to communicate with a local server instead of the hosted cloud.
# E.g. http://localhost:3000
API_URL=

# ---- Database Configuration -------------------------------------------------
# Postgres connection URL. Prisma uses this schema:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# E.g. postgresql://postgres:postgres@localhost:5432/codexa
DATABASE_URL=

# ---- AI Provider API Keys --------------------------------------------------
# At least one provider is required for LLM chat operations.
# Get Anthropic keys at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Get OpenAI keys at: https://platform.openai.com/
OPENAI_API_KEY=

# ---- Clerk Authentication (Server) ------------------------------------------
# Find these in the Clerk Dashboard under 'API Keys'.
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_SECRET=
CLERK_OAUTH_CLIENT_ID=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# HS256 secret key for signing internal tokens / sessions
# Generate a secure string for production, e.g. using `openssl rand -base64 32`
JWT_SECRET=

# ---- Polar Billing Integration ----------------------------------------------
# Access token, Product ID and Credit Meter ID for user billing and quota control.
# Get tokens from the Polar dashboard: https://polar.sh/
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_CREDITS_METER_ID=
# Polar environment: "sandbox" (default for development/testing) or "production"
POLAR_SERVER=sandbox

# ---- Observability (Optional) -----------------------------------------------
# Sentry DSN link for crash reporting and error monitoring.
SENTRY_DSN=
# Sentry trace sample rate: float value between 0.0 and 1.0 (e.g. 0.1 represents 10%)
SENTRY_TRACES_SAMPLE_RATE=0.1
